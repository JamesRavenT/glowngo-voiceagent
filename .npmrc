# Flat, npm-style node_modules instead of pnpm's symlinked .pnpm layout.
#
# Required for `opennextjs-cloudflare build` on Windows. The adapter's copyTracedFiles
# step mirrors the traced dependency tree, and recreates a symlink whenever the source
# is itself a symlink — which, under pnpm's default linker, is every package. Windows
# forbids symlink creation without Developer Mode or elevation, so the build dies with
# EPERM. With a hoisted layout the sources are real files, so the adapter copies them.
#
# Also keeps local builds identical to Cloudflare Workers Builds.
# Trade-off: undeclared transitive imports are no longer caught at resolution time.
node-linker=hoisted
