{
  "name": "glow-and-go",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "allure:generate": "allure generate allure-results -o allure-report",
    "allure:open": "allure open allure-report",
    "test:e2e:report": "node scripts/allure-e2e.mjs",
    "dev": "next dev",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "build": "next build --webpack",
    "build:e2e": "node scripts/build-e2e.mjs",
    "check:bloat": "node scripts/check-bloat.ts",
    "generate:kb": "tsx scripts/generate-knowledge-base.ts",
    "crop:storefront": "node scripts/crop-storefront.ts",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "pnpm build:e2e && bddgen --config playwright.config.ts && playwright test --config playwright.config.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@elevenlabs/react": "^1.10.0",
    "@opennextjs/cloudflare": "^1.20.1",
    "@sentry/nextjs": "^10.66.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "allure": "^3.14.3",
    "allure-playwright": "^3.10.2",
    "playwright-bdd": "9.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "shadcn": "^4.13.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  }
}
