# n8n reverse-proxy deployment — copy to .env and fill in. .env is gitignored; never commit it.

# Apex domain you control (registered + DNS pointed at the VM). Example only:
DOMAIN_NAME=example.com
# Subdomain n8n is served at, giving n8n.example.com:
SUBDOMAIN=n8n
# Contact email for Let's Encrypt certificate notices:
LETSENCRYPT_EMAIL=you@example.com

# Generate ONCE with:  openssl rand -hex 24
# Set it before first start and NEVER change it — it decrypts stored credentials. Losing it
# makes every saved credential (e.g. the Google service account) unrecoverable.
N8N_ENCRYPTION_KEY=

# n8n image tag. 'latest' works; pin to a specific version (e.g. 1.70.0) for reproducible,
# deliberate updates. See docs/deployment-google-cloud.md.
N8N_IMAGE_TAG=latest
