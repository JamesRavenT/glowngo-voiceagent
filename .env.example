# Public agent mode; safe local default is `simulated`.
NEXT_PUBLIC_AGENT_MODE=simulated

# Public project UUID for access-key verification; this identifier is not a secret. On Cloudflare,
# configure it as a BUILD variable because NEXT_PUBLIC_* values are inlined at build time.
NEXT_PUBLIC_ACCESS_PROJECT_ID=

# Public ElevenLabs agent ID; leave empty in simulated mode.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Public synthetic booking sheet URL; leave empty to hide the link.
NEXT_PUBLIC_BOOKING_SHEET_URL=

# Public Sentry DSN; leave empty to disable browser error reporting.
NEXT_PUBLIC_SENTRY_DSN=

# Sentry organization slug for source-map uploads; leave empty locally.
SENTRY_ORG=

# Sentry project slug for source-map uploads; leave empty locally.
SENTRY_PROJECT=

# Secret Sentry source-map upload token; leave empty and never commit a real value.
SENTRY_AUTH_TOKEN=

# Local-only ElevenLabs administration key; leave empty and never expose it as NEXT_PUBLIC_*.
ELEVENLABS_API_KEY=
