# Defaults to `simulated`. Set to `live` after James provides the live agent configuration.
NEXT_PUBLIC_AGENT_MODE=simulated

# Unset until James provides the ElevenLabs agent ID.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Unset until James provides the public synthetic booking sheet URL.
NEXT_PUBLIC_BOOKING_SHEET_URL=

# Sentry error monitoring. NEXT_PUBLIC_* values are inlined at build time on
# Cloudflare, so set this as a build variable, never as a Wrangler runtime var.
# The DSN is public by design and safe to expose.
NEXT_PUBLIC_SENTRY_DSN=

# Sentry source-map upload coordinates. Keep placeholders here; configure the
# real values only in the build environment.
SENTRY_ORG=
SENTRY_PROJECT=

# Secret, build-time only. Never commit it or add it to Wrangler runtime vars.
# Source-map upload is skipped when this is unset.
SENTRY_AUTH_TOKEN=
